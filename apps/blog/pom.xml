<?xml version="1.0" encoding="UTF-8"?>
<!--
  blog-service / pom.xml
  [무엇을] 블로그 포스트 관리 + 외부 자동발행(Tistory·Velog). 독립 배포 단위.
  [왜/MSA] Phase 4 — monolith의 BlogPost·DevNote를 분리. openclaw blog-service의
           자동발행 엔진을 Spring Boot 3.2로 통합(스택 수렴).
  [포트] 8086. 스키마: blog.
  @PHASE:4
  @FROM  K-portfolio entity/BlogPost·DevNote + openclaw blog-service TistoryApiClient·VelogApiClient
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    <groupId>com.kmsa</groupId>
    <artifactId>blog-service</artifactId>
    <version>1.0.0</version>
    <name>blog-service</name>
    <description>블로그 포스트 관리 + Tistory·Velog 자동발행</description>
    <properties><java.version>17</java.version></properties>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <!-- [Phase 6] Prometheus 메트릭 -->
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build><plugins>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins></build>
</project>
