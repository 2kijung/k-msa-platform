<?xml version="1.0" encoding="UTF-8"?>
<!--
  contact-service / pom.xml
  [무엇을] 문의(Contact) 접수 + 알림 연동 서비스. 독립 배포 단위.
  [왜/MSA] auth-service와 동일하게 자기 pom/포트/스키마를 가진 독립 서비스.
           auth와 달리 Security starter가 필요 없다(인증은 게이트웨이가 이미 처리, 헤더만 신뢰).
  [auth와 차이] spring-boot-starter-security 제외, RestTemplate으로 notification 호출 추가.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>
    <groupId>com.kmsa</groupId>
    <artifactId>contact-service</artifactId>
    <version>1.0.0</version>
    <name>contact-service</name>
    <description>문의 접수 + 알림 연동 서비스</description>
    <properties><java.version>17</java.version></properties>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <!-- [Phase 6] 회복탄력성: 서킷브레이커·타임아웃·재시도 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <!-- [Phase 6] Prometheus 메트릭 노출 (Resilience4j 서킷 상태 포함) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- [Phase 6] Zipkin 분산 트레이싱: contact→notification 호출 흐름을 traceId로 추적 -->
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-tracing-bridge-brave</artifactId></dependency>
        <dependency><groupId>io.zipkin.reporter2</groupId><artifactId>zipkin-reporter-brave</artifactId></dependency>
        <!-- [왜] AOP 없이 Resilience4j @CircuitBreaker 어노테이션 동작 안 함 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build><plugins>
        <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins></build>
</project>
