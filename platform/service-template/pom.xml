<?xml version="1.0" encoding="UTF-8"?>
<!--
  service-template / pom.xml
  ============================================================================
  [무엇을] 새 서비스의 시작점. 이 파일을 복사해 artifactId·description만 바꾼다.
  [왜/MSA] 모든 서비스가 동일한 의존성 베이스라인을 가지면:
    - 의존성 버전 충돌 없음 (Boot parent가 BOM 역할)
    - 관측성·트레이싱이 기본 탑재 → 새 서비스도 자동으로 Prometheus·Zipkin에 잡힘
    - 빌드 방식 일관 → Jenkinsfile parallel stage에 추가만 하면 됨
  [사용법] 복사 후 아래 3군데만 수정:
    1. <artifactId>  → 새 서비스 이름
    2. <description> → 설명
    3. 필요 없는 의존성 제거 (JPA 없는 서비스는 data-jpa 제거)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.kmsa</groupId>
    <artifactId>my-service</artifactId>   <!-- ★ 교체 -->
    <version>1.0.0</version>
    <name>my-service</name>
    <description>새 서비스 설명</description>  <!-- ★ 교체 -->

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web: REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: DB가 필요한 서비스만. 무상태 서비스는 제거. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Actuator: /actuator/health (K8s probe) + /actuator/prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- [관측성 1] Prometheus 메트릭 노출 — 추가만 하면 /actuator/prometheus 자동 등록 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- [관측성 2] Zipkin 분산 트레이싱 — RestTemplateBuilder 사용 시 outgoing 요청에 traceId 자동 전파 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- PostgreSQL 드라이버 (DB 사용 서비스만) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2: 단위 테스트 전용 (실물 DB는 docker-compose postgres) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
